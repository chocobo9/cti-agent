## =========================
## Neo4j (Session A / graph)
## =========================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

## ==================================
## Enrichment APIs / datasets (Session B)
## ==================================
OTX_API_KEY=your_alienvault_otx_api_key_here
GEOIP_LICENSE_KEY=your_geoip_license_key_here
GEOIP_ASN_DB_PATH=./data/db/GeoLite2-ASN.mmdb
GEOIP_CITY_DB_PATH=./data/db/GeoLite2-City.mmdb
ABUSE_CH_AUTH_KEY=your_abuse_ch_auth_key_here
WHOXY_API_KEY=your_key_here
## ============================
## Optional tuning (Session B)
## ============================
HTTP_TIMEOUT=15.0
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
BATCH_CONCURRENCY=10
DNS_RESOLVER=8.8.8.8
USER_AGENT=CTI-Agent-Enrichment/0.1

## ============================
## LLM API
## ============================
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE