## =========================
## Neo4j (Session A / graph)
## =========================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

## ==================================
## Enrichment APIs / datasets (Session B)
## ==================================
OTX_API_KEY=your_alienvault_otx_api_key_here
GEOIP_ASN_DB_PATH=./data/GeoLite2-ASN.mmdb
GEOIP_CITY_DB_PATH=./data/GeoLite2-City.mmdb

## ============================
## Optional tuning (Session B)
## ============================
HTTP_TIMEOUT=15.0
MAX_RETRIES=3
RETRY_BASE_DELAY=1.0
BATCH_CONCURRENCY=10
DNS_RESOLVER=8.8.8.8
USER_AGENT=CTI-Agent-Enrichment/0.1
